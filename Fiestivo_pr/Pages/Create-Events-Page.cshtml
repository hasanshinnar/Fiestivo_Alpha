@page
@model Fiestivo.Pages.Create_Events_PageModel
@{
    Layout = "_Layout";
}
<main class="Create_form">
    <h1 class="Create_form__title">Create Your Event</h1>

    <form method="post" enctype="multipart/form-data" class="Create_form">
        <div asp-validation-summary="All" class="text-danger"></div>

        <!-- Event Basics Section -->
        <section class="Create_form__section">
            <h2 class="Create_form__section-title">
                <i class="fas fa-info-circle Create_form__section-title-icon"></i> Event Basics
            </h2>

            <div class="Create_form__row">
                <div class="Create_form__group">
                    <label for="eventName" class="Create_form__label">Event Name</label>
                    <input type="text" id="eventName" name="Event.Event_Title" class="Create_form__input" placeholder="e.g. Annual Tech Conference">
                </div>

                <div class="Create_form__group">
                    <label for="Category_ID" class="Create_form__label">Event Category</label>
                    <select id="Category_ID" name="Event.Category_ID" class="Create_form__select">
                        <option value="">Select event type</option>
                        @foreach (var category in Model.CategoriesSelectList)
                        {
                            <option value="@category.Value">@category.Text</option>
                        }
                    </select>
                </div>
            </div>

            <div class="Create_form__row">
                <div class="Create_form__group">
                    <label for="date" class="Create_form__label">Event Date</label>
                    <input type="date" id="date" name="Event.Event_Date" class="Create_form__input">
                </div>

                <div class="Create_form__group">
                    <label for="time" class="Create_form__label">Start Time</label>
                    <input type="time" id="time" name="Event.Event_time" class="Create_form__input">
                </div>

                <div class="Create_form__group">
                    <label for="duration" class="Create_form__label">Duration (hours)</label>
                    <input type="number" id="duration" name="Event.Event_Duration" class="Create_form__input" placeholder="e.g. 3">
                </div>
            </div>

            <div class="Create_form__group">
                <label for="description" class="Create_form__label">Event Description</label>
                <textarea id="description" name="Event.Event_Discription" class="Create_form__textarea" rows="4" placeholder="Tell attendees what to expect..."></textarea>
            </div>

            <!-- Privacy Toggle -->
            <div class="Create_privacy-toggle">
                <span class="Create_privacy-toggle__label">Private</span>
                <label class="Create_privacy-toggle__switch">
                    <input type="checkbox" asp-for="Event.IsPublic" id="privacyToggle">
                    <span class="Create_privacy-toggle__slider"></span>
                </label>
                <span class="Create_privacy-toggle__label">Public</span>
            </div>

            <div class="Create_form__group">
                <label for="eventImage" class="Create_form__label">Event Image</label>
                <input type="file" id="eventImage" name="Event_Picture" class="Create_form__input" accept="image/*" required="false">
            </div>
        </section>

        <!-- Location & Attendance Section -->
        <section class="Create_form__section">
            <h2 class="Create_form__section-title">
                <i class="fas fa-map-marker-alt Create_form__section-title-icon"></i> Location & Attendance
            </h2>

            <div class="Create_form__row">
                <div class="Create_form__group">
                    <label for="location" class="Create_form__label">Event Location</label>
                    <input type="text" id="location" name="Event.Event_Location" class="Create_form__input" placeholder="Venue name or address">
                </div>

                <div class="Create_form__group">
                    <label for="expectedAttendees" class="Create_form__label">Expected Attendance</label>
                    <input type="number" id="expectedAttendees" name="Event.Attendees_Number" class="Create_form__input" placeholder="e.g. 150">
                </div>
            </div>

            <div class="Create_form__group">
                <label for="locationDetails" class="Create_form__label">Additional Location Details</label>
                <textarea id="locationDetails" name="Event.Event_Location_Details" class="Create_form__textarea" rows="3" placeholder="Parking info, special instructions, etc."></textarea>
            </div>
        </section>

        <!-- AI Section -->
        <section class="Create_form__section">
            <h2 class="Create_form__section-title">
                <i class="fas fa-robot Create_form__section-title-icon"></i> AI
            </h2>

            <button type="button" class="Create_btn Create_btn--ai" id="openAiModal">
                <i class="fas fa-magic"></i> Get AI Budget Recommendations
            </button>
        </section>

        <!-- Submit Section -->
        <div class="Create_form__actions">
            <button type="submit" class="Create_btn Create_btn--primary">
                <i class="fas fa-check-circle">Create Event</i>
            </button>
        </div>
    </form>
</main>

<!-- AI Recommendation Modal -->
<div id="aiModal" class="Create_modal">
    <div class="Create_modal__content">
        <h3 class="Create_modal__title">AI Budget Recommendations</h3>
        <div class="Create_form__group">
            <label class="Create_form__label">Total Budget (in Dinars)</label>
            <input type="number" id="totalBudget" class="Create_form__input" placeholder="Enter total budget">
        </div>
        <div id="categoryContainer">
            <div class="Create_category-row">
                <select class="Create_category-row__select Create_form__select">
                    <option value="Food">Food</option>
                    <option value="Decoration">Decoration</option>
                    <option value="Photo Booth">Photo Booth</option>
                    <option value="DJ">DJ</option>
                    <option value="Others">Others</option>
                </select>
                <input type="number" class="Create_category-row__input Create_form__input" placeholder="Amount">
                <button class="Create_category-row__remove-btn" onclick="removeCategoryRow(this)">×</button>
            </div>
        </div>
        <button type="button" class="Create_btn Create_btn--secondary Create_modal__add-category" id="addCategory">
            <i class="fas fa-plus"></i> Add Category
        </button>
        <button type="button" class="Create_btn Create_btn--primary" id="getRecommendation">
            <i class="fas fa-lightbulb"></i> Get Recommendation
        </button>
    </div>
</div>

<!-- Results Modal -->
<div id="resultsModal" class="Create_modal Create_modal--results">
    <div class="Create_modal__results-content">
        <h3 class="Create_modal__title">AI Recommendations</h3>
        <table class="Create_recommendation-table">
            <thead>
                <tr>
                    <th class="Create_recommendation-table__header">Category</th>
                    <th class="Create_recommendation-table__header">Your Amount</th>
                    <th class="Create_recommendation-table__header">Recommended</th>
                    <th class="Create_recommendation-table__header">Percentage</th>
                </tr>
            </thead>
            <tbody id="recommendationResults">
                <!-- Results will be populated here -->
            </tbody>
        </table>
        <div class="Create_ai-tip">
            <p class="Create_ai-tip__text">Based on our analysis of similar events, we recommend adjusting your budget allocations for optimal results.</p>
        </div>
        <div class="Create_modal__results-actions">
            <button type="button" class="Create_btn Create_btn--secondary" id="closeResults">Done</button>
            <button type="button" class="Create_btn Create_btn--primary" id="saveRecommendation">Save</button>
        </div>
    </div>
</div>