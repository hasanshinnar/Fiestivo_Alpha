@page
@model Fiestivo.Pages.User_Profile_PageModel
@{
}
@{
    Layout = "_Layout";
}

<div class="User_Profile_container">
    @Html.AntiForgeryToken()

    <div class="User_Profile_profile">
        <img src="/User-Profile-Page?handler=ProfilePicture" alt="Profile Picture" class="User_Profile_profile__picture">
        
        <div class="User_Profile_profile__details">
            <h2 class="User_Profile_profile__name">@Model.CurrentUser?.Full_Name</h2>
            <p class="User_Profile_profile__username">@@@Model.CurrentUser?._User_Name</p>

            <div class="User_Profile_profile__stats">
                <div class="User_Profile_profile__stat-item">
                    <span class="User_Profile_profile__stat-number">@(Model.CurrentUser?.Events?.Count ?? 0)</span>
                    <span class="User_Profile_profile__stat-label">Events Created</span>
                </div>
            </div>

            <p class="User_Profile_profile__bio">@(Model.CurrentUser?.Bio ?? "No bio available")</p>

            <button class="User_Profile_profile__edit-btn" onclick="showEditProfileModal()">
                <i class="material-icons User_Profile_profile__edit-btn-icon">edit</i>
                Edit Profile
            </button>
        </div>
    </div>

    <div class="User_Profile_drawers">
        <div class="User_Profile_drawer">
            <div class="User_Profile_drawer__header" onclick="toggleDrawer('my-events')">
                <h3 class="User_Profile_drawer__title">My Events</h3>
                <i class="material-icons material-icons--rotate-180">keyboard_arrow_down</i>
            </div>
            <div class="User_Profile_drawer__content" id="my-events">
                <div class="User_Profile_carousel">
                    <div class="User_Profile_carousel__container" id="my-events-carousel">
                        @if (Model.CurrentUser?.Events != null && Model.CurrentUser.Events.Any())
                        {
                            @foreach (var eventItem in Model.CurrentUser.Events)
                            {
                                <div class="User_Profile_event-card">
                                    <!-- زر الحذف -->
                                    <button class="User_Profile_event-card__delete-btn"
                                            onclick="deleteEventFromProfile('@eventItem.Event_ID')">
                                        <i class="material-icons">delete</i>
                                    </button>

                                    <!-- زر التعديل -->
                                    <button class="User_Profile_event-card__edit-btn"
                                            onclick="showEditModal('@eventItem.Event_ID', '@eventItem.Event_Title')">
                                        <i class="material-icons">edit</i>
                                    </button>
                                    @if (eventItem.Event_Picture != null && eventItem.Event_Picture.Length > 0)
                                    {
                                        <img src="data:image/jpeg;base64,@Convert.ToBase64String(eventItem.Event_Picture)"
                                             alt="@eventItem.Event_Title" class="User_Profile_event-card__image">
                                    }
                                    else
                                    {
                                        <img src="~/img/User-Profile-Page-imgs/default-event-image.jpg"
                                             alt="@eventItem.Event_Title" class="User_Profile_event-card__image">
                                    }
                                    <div class="User_Profile_event-card__content">
                                        <h3 class="User_Profile_event-card__title">@eventItem.Event_Title</h3>
                                        <p class="User_Profile_event-card__date">@eventItem.Event_Date.ToString("MMMM dd, yyyy")</p>
                                        <div class="User_Profile_event-card__attendees">
                                            <i class="material-icons User_Profile_event-card__attendees-icon">people</i>
                                            <span>@(eventItem.Attends?.Count ?? 0)/@eventItem.Attendees_Number attendees</span>
                                        </div>
                                        <div class="User_Profile_event-card__actions">
                                            <a href="/Event-View-Page?id=@eventItem.Event_ID"><button class="User_Profile_event-card__btn">View Details</button></a>
                                            <button class="User_Profile_event-card__btn"
                                                    onclick="showGuestsModal('@eventItem.Event_ID', '@eventItem.Event_Title')">
                                                View Guests
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p>No events created yet.</p>
                        }
                    </div>
                    @if (Model.CurrentUser?.Events != null && Model.CurrentUser.Events.Count > 1)
                    {
                        <div class="User_Profile_carousel__nav">
                            <button class="User_Profile_carousel__btn" onclick="prevSlide('my-events-carousel')">
                                <i class="material-icons User_Profile_carousel__btn-icon">chevron_left</i>
                            </button>
                            <button class="User_Profile_carousel__btn" onclick="nextSlide('my-events-carousel')">
                                <i class="material-icons User_Profile_carousel__btn-icon">chevron_right</i>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="User_Profile_drawer">
            <div class="User_Profile_drawer__header" onclick="toggleDrawer('booked-events')">
                <h3 class="User_Profile_drawer__title">Booked Events</h3>
                <i class="material-icons material-icons--rotate-180">keyboard_arrow_down</i>
            </div>
            <div class="User_Profile_drawer__content" id="booked-events">
                <div class="User_Profile_carousel">
                    <div class="User_Profile_carousel__container" id="booked-events-carousel">
                        @if (Model.BookedEvents != null && Model.BookedEvents.Any())
                        {
                            @foreach (var eventItem in Model.BookedEvents)
                            {
                                <div class="User_Profile_event-card">
                                    @if (eventItem.Event_Picture != null && eventItem.Event_Picture.Length > 0)
                                    {
                                        <img src="data:image/jpeg;base64,@Convert.ToBase64String(eventItem.Event_Picture)"
                                             alt="@eventItem.Event_Title" class="User_Profile_event-card__image">
                                    }
                                    else
                                    {
                                        <img src="~/img/User-Profile-Page-imgs/default-event-image.jpg"
                                             alt="@eventItem.Event_Title" class="User_Profile_event-card__image">
                                    }
                                    <div class="User_Profile_event-card__content">
                                        <h3 class="User_Profile_event-card__title">@eventItem.Event_Title</h3>
                                        <p class="User_Profile_event-card__date">@eventItem.Event_Date.ToString("MMMM dd, yyyy")</p>
                                        <div class="User_Profile_event-card__attendees">
                                            <i class="material-icons User_Profile_event-card__attendees-icon">people</i>
                                            <span>@eventItem.Attendees_Number attendees</span>
                                        </div>
                                        <div class="User_Profile_event-card__actions">
                                            <a href="/Event-View-Page?id=@eventItem.Event_ID"><button class="User_Profile_event-card__btn">View Details</button></a>
                                            <button class="User_Profile_event-card__btn"
                                                    onclick="cancelBookingFromProfile('@eventItem.Event_ID')">
                                                Cancel
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p>No booked events yet.</p>
                        }
                    </div>
                    @if (Model.BookedEvents != null && Model.BookedEvents.Count > 1)
                    {
                        <div class="User_Profile_carousel__nav">
                            <button class="User_Profile_carousel__btn" onclick="prevSlide('booked-events-carousel')">
                                <i class="material-icons User_Profile_carousel__btn-icon">chevron_left</i>
                            </button>
                            <button class="User_Profile_carousel__btn" onclick="nextSlide('booked-events-carousel')">
                                <i class="material-icons User_Profile_carousel__btn-icon">chevron_right</i>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Guests Modal -->
<div class="User_Profile_modal" id="guestsModal">
    <div class="User_Profile_modal__content">
        <div class="User_Profile_modal__header">
            <h3 class="User_Profile_modal__title" id="modalEventTitle">Event Guests</h3>
            <button class="User_Profile_modal__close-btn" onclick="closeModal()">&times;</button>
        </div>
        <div class="User_Profile_modal__body">
            <ul class="User_Profile_guest-list" id="guestList">
                <!-- Guest items will be added dynamically -->
            </ul>
        </div>
    </div>
</div>

<!-- Edit Event Modal -->
<div class="User_Profile_modal" id="editEventModal">
    <div class="User_Profile_modal__content">
        <div class="User_Profile_modal__header">
            <h3 class="User_Profile_modal__title">Edit Event</h3>
            <button class="User_Profile_modal__close-btn" onclick="closeModal()">&times;</button>
        </div>
        <div class="User_Profile_modal__body">
            <form id="editEventForm">
                @Html.AntiForgeryToken()
                <div class="User_Profile_form__group">
                    <label for="eventName" class="User_Profile_form__label">Event Name</label>
                    <input type="text" id="eventName" name="Event_Title" class="User_Profile_form__control" required>
                </div>

                <div class="User_Profile_form__group">
                    <label for="eventType" class="User_Profile_form__label">Event Type</label>
                    <select id="eventType" name="Category_ID" class="User_Profile_form__select" required>
                        <option value="">Select Event Type</option>
                        <option value="BirthDay">BirthDay</option>
                        <option value="Stand-Up Comedy">Stand-Up Comedy</option>
                        <option value="Conference">Conference</option>
                        <option value="Tech & Business">Tech & Business</option>
                        <option value="Cultural & Art">Cultural & Art</option>
                        <option value="Festival">Festival</option>
                        <option value="Kids Activities">Kids Activities</option>
                        <option value="Wedding">Wedding</option>
                        <option value="Sport Event">Sport Event</option>
                    </select>
                </div>
                <div class="User_Profile_form__group">
                    <label class="User_Profile_form__label">Event Picture</label>
                    <div class="User_Profile_file-input">
                        <img id="eventPicturePreview" src="" class="User_Profile_event__picture-preview">
                        <label for="eventPicture" class="User_Profile_file-input__label">
                            <i class="material-icons">photo_camera</i> Change Photo
                        </label>
                        <input type="file" id="eventPicture" name="EventPicture" class="User_Profile_file-input__field" accept="image/*">
                    </div>
                </div>
                <div class="User_Profile_form__group">
                    <label for="eventDate" class="User_Profile_form__label">Event Date</label>
                    <input type="date" id="eventDate" name="Event_Date" class="User_Profile_form__control" required>
                </div>
                <div class="User_Profile_form__group">
                    <label for="startTime" class="User_Profile_form__label">Start Time</label>
                    <input type="time" id="startTime" name="Event_time" class="User_Profile_form__control" required>
                </div>

                <div class="User_Profile_form__group">
                    <label for="duration" class="User_Profile_form__label">Duration (hours)</label>
                    <input type="number" id="duration" name="Event_Duration" class="User_Profile_form__control" required>
                </div>

                <div class="User_Profile_form__group">
                    <label for="expectedAttendance" class="User_Profile_form__label">Expected Attendance</label>
                    <input type="number" id="expectedAttendance" name="Attendees_Number" class="User_Profile_form__control" required>
                </div>

                <div class="User_Profile_form__group">
                    <label for="eventLocation" class="User_Profile_form__label">Event Location</label>
                    <input type="text" id="eventLocation" name="Event_Location" class="User_Profile_form__control" required>
                </div>

                <div class="User_Profile_form__group">
                    <label for="locationDetails" class="User_Profile_form__label">Additional Location Details</label>
                    <textarea id="locationDetails" name="Event_Location_Details" class="User_Profile_form__control"></textarea>
                </div>

                <div class="User_Profile_form__group">
                    <label for="eventDescription" class="User_Profile_form__label">Event Description</label>
                    <textarea id="eventDescription" name="Event_Discription" class="User_Profile_form__control" required></textarea>
                </div>

                <div class="User_Profile_form__group">
                    <label class="User_Profile_form__label">Event Privacy</label>
                    <div class="User_Profile_switch">
                        <span class="User_Profile_switch_label User_Profile_switch_label--active" id="privateLabel">Private</span>
                        <label class="User_Profile_switch__toggle">
                            <input type="checkbox" id="eventPrivacy" name="IsPublic">
                            <span class="User_Profile_switch__slider"></span>
                        </label>
                        <span class="User_Profile_switch__label" id="publicLabel">Public</span>
                    </div>
                </div>
            </form>
        </div>
        <div class="User_Profile_modal__footer">
            <button class="User_Profile_btn User_Profile_btn--secondary" onclick="closeModal()">Cancel</button>
            <button class="User_Profile_btn User_Profile_btn--primary" onclick="saveEventChanges()">Save Changes</button>
        </div>
    </div>
</div>

<!-- Edit Profile Modal -->
<div class="User_Profile_modal" id="editProfileModal">
    <div class="User_Profile_modal__content">
        <div class="User_Profile_modal__header">
            <h3 class="User_Profile_modal__title">Edit Profile</h3>
            <button class="User_Profile_modal__close-btn" onclick="closeModal()">&times;</button>
        </div>
        <form method="post" id="editProfileForm" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="User_Profile_modal__body">
                <div class="User_Profile_file-input">
                    <img id="profilePicturePreview" src="@(Model.CurrentUser?.ProfilePicture != null ? $"data:image;base64,{Convert.ToBase64String(Model.CurrentUser.ProfilePicture)}" : "/img/LoginSignup-Page-imgs/default_image.png")" class="User_Profile_profile__picture-preview">
                    <label for="profilePicture" class="User_Profile_file-input__label">
                        <i class="material-icons">photo_camera</i> Change Photo
                    </label>
                    <input type="file" id="profilePicture" name="EditProfile.ProfileImage" class="User_Profile_file-input__field" accept="image/*">
                </div>

                <div class="User_Profile_form__group">
                    <label for="fullName" class="User_Profile_form__label">Full Name</label>
                    <input type="text" id="fullName" name="EditProfile.FullName" class="User_Profile_form__control"
                           value="@(Model.EditProfile?.FullName ?? Model.CurrentUser?.Full_Name)" required>
                </div>

                <div class="User_Profile_form__group">
                    <label for="bio" class="User_Profile_form__label">Bio</label>
                    <textarea id="bio" name="EditProfile.Bio" class="User_Profile_form__control" rows="4">@(Model.EditProfile?.Bio ?? Model.CurrentUser?.Bio)</textarea>
                </div>
                <div class="User_Profile_drawer">
                    <div class="User_Profile_drawer__header" onclick="toggleDrawer('change-password')">
                        <h3 class="User_Profile_drawer__title">Change Password</h3>
                        <i class="material-icons material-icons--rotate-180">keyboard_arrow_down</i>
                    </div>
                    <div class="User_Profile_drawer__content User_Profile_drawer__content--closed" id="change-password">
                        <div class="User_Profile_form">
                            <div class="User_Profile_form__group">
                                <label for="currentPassword" class="User_Profile_form__label">Current Password</label>
                                <input type="password" id="currentPassword" name="EditProfile.CurrentPassword" class="User_Profile_form__control">
                                <span asp-validation-for="EditProfile.CurrentPassword" class="text-danger"></span>
                            </div>

                            <div class="User_Profile_form__group">
                                <label for="newPassword" class="User_Profile_form__label">New Password</label>
                                <input type="password" id="newPassword" name="EditProfile.NewPassword" class="User_Profile_form__control">
                                <span asp-validation-for="EditProfile.NewPassword" class="text-danger"></span>
                            </div>

                            <div class="User_Profile_form__group">
                                <label for="confirmPassword" class="User_Profile_form__label">Confirm New Password</label>
                                <input type="password" id="confirmPassword" name="EditProfile.ConfirmPassword" class="User_Profile_form__control">
                                <span asp-validation-for="EditProfile.ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="User_Profile_modal__footer">
                <button type="button" class="User_Profile_btn User_Profile_btn--secondary" onclick="closeModal()">Cancel</button>
                <button type="submit" class="User_Profile_btn User_Profile_btn--primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>
