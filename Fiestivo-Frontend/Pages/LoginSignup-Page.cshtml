@page
@model Fiestivo.Pages.LoginSignupModel
@{
}
@{
    Layout = "_Layout";
}
<head>
    <link rel="stylesheet" href="~/css/LoginSignup-Page.css">
</head>
<div class="fiestivo-login__login-container">
    <div class="fiestivo-login__form-container">
        <div class="curved-shape"></div>
        <div class="curved-shape2"></div>

        <!-- Login Form -->
        <div class="fiestivo-login__form-box fiestivo-login__form-box--login">
            <h2 class="fiestivo-login__form-title">Login</h2>
            <form method="post">
                <input type="hidden" name="FormType" value="login" />
                <div class="fiestivo-login__input-box">
                    <input type="text" id="username" asp-for="Username" maxlength="8" required class="fiestivo-login__input" />
                    <label for="username" class="fiestivo-login__label">Username</label>
                    <i class="bx bx-user fiestivo-login__icon"></i>
                </div>

                <div class="fiestivo-login__input-box fiestivo-login__input-box--password">
                    <input type="password" id="password" asp-for="Password" maxlength="8" required class="fiestivo-login__input" />
                    <label for="password" class="fiestivo-login__label">Password</label>
                    <i class="bx bx-lock fiestivo-login__icon"></i>
                </div>

                <button class="fiestivo-login__btn" type="submit">Login</button>

                <div class="fiestivo-login__regi-link">
                    <p class="fiestivo-login__regi-link-text">Don't have an account? <a href="#" class="signUpLink fiestivo-login__regi-link-signup"><i class="bx bx-user-plus"></i> Sign Up</a></p>
                </div>
            </form>
        </div>

        <!-- Sign Up Form -->
        <div class="fiestivo-login__form-box fiestivo-login__form-box--register">
            <h2 class="fiestivo-login__form-title">Sign Up</h2>
            <form method="post">
                <input type="hidden" name="FormType" value="signup" />
                <div class="fiestivo-login__input-box">
                    <input type="text" id="fullname" asp-for="Fullname" required class="fiestivo-login__input" />
                    <label for="fullname" class="fiestivo-login__label">Full name</label>
                    <i class="bx bx-user fiestivo-login__icon"></i>
                </div>
                <div class="fiestivo-login__input-box">
                    <input type="text" id="reg-username" asp-for="Username" maxlength="8" required class="fiestivo-login__input" />
                    <label for="reg-username" class="fiestivo-login__label">Username</label>
                    <i class="bx bx-user fiestivo-login__icon"></i>
                </div>

                <div class="fiestivo-login__input-box">
                    <input type="email" id="email" asp-for="Email" required class="fiestivo-login__input" />
                    <label for="email" class="fiestivo-login__label">Email</label>
                    <i class="bx bx-envelope fiestivo-login__icon"></i>
                </div>

                <div class="fiestivo-login__input-box fiestivo-login__input-box--password">
                    <input type="password" id="reg-password" asp-for="Password" maxlength="8" required class="fiestivo-login__input" />
                    <label for="reg-password" class="fiestivo-login__label">Password</label>
                    <i class="bx bx-lock fiestivo-login__icon"></i>
                </div>

                @if (ViewData["ShowVerification"] != null && (bool)ViewData["ShowVerification"] == true)
                {
                    <div class="fiestivo-login__input-box">
                        <input type="text" id="verification-code" name="VerificationCode" required class="fiestivo-login__input" />
                        <label for="verification-code" class="fiestivo-login__label">Verification Code</label>
                        <i class="bx bx-key fiestivo-login__icon"></i>
                    </div>

                    <button class="fiestivo-login__btn" type="submit">Verify Code</button>
                }
                else
                {
                    <button class="fiestivo-login__btn" type="submit">Sign Up</button>
                }
            </form>
        </div>
    </div>
</div>
