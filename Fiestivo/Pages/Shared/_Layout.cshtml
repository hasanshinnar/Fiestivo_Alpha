<!DOCTYPE html>

@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Mvc.TagHelpers
@inject IHttpContextAccessor HttpContextAccessor

@{
    var userId = HttpContextAccessor.HttpContext?.Session.GetInt32("UserId");
}
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fiestivo</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Fiestivo.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/Categories-Page.css">
    <link href="~/css/Create-Events-Page.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Event-View-Page.css">
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />
    <link href="~/css/User-Profile-Page.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <style>
        #searchSuggestions {
            scrollbar-width: thin;
            scrollbar-color: #ddd transparent;
        }

            #searchSuggestions::-webkit-scrollbar {
                width: 6px;
            }

            #searchSuggestions::-webkit-scrollbar-track {
                background: transparent;
            }

            #searchSuggestions::-webkit-scrollbar-thumb {
                background-color: #ddd;
                border-radius: 20px;
            }

        .search-suggestion-item {
            border-bottom: 1px solid #eee;
        }

            .search-suggestion-item:last-child {
                border-bottom: none;
            }
    </style>


</head>
<body class="home_page">
    <header class="navbar w-full bg-black bg-opacity-70 backdrop-blur-sm py-4 px-6 z-50 relative">
        <div class="navbar__container container mx-auto flex flex-col md:flex-row items-center justify-between gap-4">

            <a href="/index" target="_top">
                <div class="navbar__logo text-white text-2xl font-bold">fiestivo</div>
            </a>

            <div class="navbar__search-container flex-1 max-w-2xl relative mx-auto">
                <form action="/Categories-Page" method="get" class="flex items-center w-full">
                    <input type="text"
                           id="globalSearch"
                           class="navbar__search-input w-full py-2 px-4 rounded-full text-black focus:outline-none"
                           placeholder="Search Event"
                           name="searchTerm"
                           autocomplete="off">

                    <div id="searchSuggestions"
                         class="absolute top-full left-0 right-0 bg-white rounded-lg shadow-lg mt-2 hidden z-50 max-h-60 overflow-y-auto">
                        <!-- سيتم تعبئة الاقتراحات هنا عبر JavaScript -->
                    </div>

                    <button type="submit" class="absolute right-4 top-1/2 transform -translate-y-1/2">
                        <!-- أيقونة البحث -->
                    </button>
                </form>
            </div>

            <div class="navbar__buttons flex items-center gap-4 ml-auto">
               
                @* <p style="color:white;">Session UserId: @userId</p> *@

                @if (userId == null)
                {
                    <!-- المستخدم مش مسجل دخول -->
                    <a href="/LoginSignup-Page" target="_top">
                        <button class="navbar_button navbar_button--secondary bg-white text-black py-2 px-6 rounded-full text-sm font-medium hover:bg-gray-200 transition">
                            Login
                        </button>
                    </a>
                }
                else
                {
                    <a href="/Create-Events-Page" target="_top">
                        <button class="navbar_button navbar_button--primary bg-black text-white py-2 px-6 rounded-full text-sm font-medium hover:bg-gray-800 transition">
                            Create Event
                        </button>
                    </a>
                    <!-- المستخدم مسجل دخول -->
                    <div class="relative">
                        <img src="/User-Profile-Page?handler=ProfilePicture"
                             class="w-10 h-10 rounded-full cursor-pointer"
                             onclick="toggleMenu()" />

                        <ul id="userMenu"
                            class="absolute right-0 mt-2 w-40 bg-white rounded shadow-lg z-[9999] hidden">
                            <li><a href="/User-Profile-Page" class="block px-4 py-2 text-gray-800 hover:bg-gray-100">My Account</a></li>
                            <li><a href="/Logout" class="block px-4 py-2 text-gray-800 hover:bg-gray-100">logout</a></li>
                        </ul>
                    </div>

                }


            </div>

        </div>
    </header>

    @RenderBody()

    <script src="~/js/index.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/Categories-Page.js"></script>
    <script src="~/js/Create-Events-Page.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/Event-View-Page.js"></script>
    <script src="~/js/LoginSignup-Page.js"></script>
    <script src="~/js/User-Profile-Page.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>




    @await RenderSectionAsync("Scripts", required: false)


    <script>
        function toggleMenu() {
            const menu = document.getElementById("userMenu");
            menu.classList.toggle("hidden");
        }
    </script>
    <script>

                document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('globalSearch');
            const suggestionsContainer = document.getElementById('searchSuggestions');
            let debounceTimer;

            searchInput.addEventListener('input', function(e) {
                clearTimeout(debounceTimer);
                const term = e.target.value.trim();

                if(term.length < 2) {
                    suggestionsContainer.classList.add('hidden');
                    return;
                }

                debounceTimer = setTimeout(async () => {
                    try {
                        const response = await fetch(`/api/events/search?term=${encodeURIComponent(term)}`);
                        const results = await response.json();

                        if(results.length > 0) {
                            const html = results.map(event => `
                                <a href="/Event-View-Page?id=${event.event_ID}"
                                   class="flex items-center p-3 hover:bg-gray-100 transition-colors">
                                    <div class="flex-1">
                                        <div class="font-medium text-gray-800">${event.event_Title}</div>
                                        <div class="text-sm text-gray-500">
                                            ${new Date(event.event_Date).toLocaleDateString()} • ${event.category}
                                        </div>
                                    </div>
                                </a>
                            `).join('');

                            suggestionsContainer.innerHTML = html;
                            suggestionsContainer.classList.remove('hidden');
                        } else {
                            suggestionsContainer.innerHTML = '<div class="p-3 text-gray-500">No results found</div>';
                            suggestionsContainer.classList.remove('hidden');
                        }
                    } catch(error) {
                        console.error('Error:', error);
                        suggestionsContainer.classList.add('hidden');
                    }
                }, 300);
            });

            // إغلاق الاقتراحات عند النقر خارجها
            document.addEventListener('click', function(e) {
                if(!searchInput.contains(e.target) {
                    suggestionsContainer.classList.add('hidden');
                }
            });

            // إبقاء الاقتراحات مفتوحة عند النقر عليها
            suggestionsContainer.addEventListener('click', function(e) {
                e.stopPropagation();
            });
        });
    </script>
</body>
</html>