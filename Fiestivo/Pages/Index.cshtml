@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
@{
    Layout = "_Layout";
}



<head>
    <link rel="stylesheet" href="~/css/index.css">

</head>
<div class="home_slider">
    <div class="home_slider__list">
        <div class="home_slider__item home_slider__item--active">
            <a href="/Categories-Page?categoryId=2">
                <img src="~/img/index-imgs/stand up comedy.webp" alt="Stand-Up Comedy">
            </a>
            <div class="home_slider__content">
                <p class="home_slider__category">ENTERTAINMENT</p>
                <h2 class="home_slider__title">Stand-Up comedy</h2>
                <p class="home_slider__description">Stand-up Comedy is raw, real, and hilarious. It turns everyday moments into laughter and transforms that laughter into unforgettable memories.</p>
            </div>
        </div>
        <div class="home_slider__item">
            <a href="/Categories-Page?categoryId=3">
                <img src="~/img/index-imgs/Conference.jpeg" alt="Conference">
            </a>
            <div class="home_slider__content">
                <p class="home_slider__category">Business & Networking</p>
                <h2 class="home_slider__title">Conference</h2>
                <p class="home_slider__description">Conference Events bring minds together. They spark innovation, fuel collaboration, and turn ideas into action. Whether it's business, tech, or education — conferences create the space where change begins.</p>
            </div>
        </div>
        <div class="home_slider__item">
            <a href="/Categories-Page?categoryId=4">
                <img src="~/img/index-imgs/Tech & Business Events.jpeg" alt="Tech & Business">
            </a>
            <div class="home_slider__content">
                <p class="home_slider__category">Business</p>
                <h2 class="home_slider__title">Tech & Business</h2>
                <p class="home_slider__description">Where innovation meets opportunity. From tech talks to business meetups, these events connect minds and spark ideas.</p>
            </div>
        </div>
        <div class="home_slider__item">
            <a href="/Categories-Page?categoryId=5">
                <img src="~/img/index-imgs/Cultural & Art Events.jpeg" alt="Cultural & Art">
            </a>
            <div class="home_slider__content">
                <p class="home_slider__category">Cultural</p>
                <h2 class="home_slider__title">Cultural & Art</h2>
                <p class="home_slider__description">A celebration of creativity and heritage—featuring art, theater, music, and cultural showcases.</p>
            </div>
        </div>
        <div class="home_slider__item">
            <a href="/Categories-Page?categoryId=6">
                <img src="~/img/index-imgs/Festival.jpeg" alt="Festival">
            </a>
            <div class="home_slider__content">
                <p class="home_slider__category">Seasonal Highlights</p>
                <h2 class="home_slider__title">Festival</h2>
                <p class="home_slider__description">Festival Events are vibrant celebrations full of energy, culture, and connection. They bring people together through music, food, art, and tradition—creating unforgettable experiences that leave a lasting impression.</p>
            </div>
        </div>
        <div class="home_slider__item">
            <a href="/Categories-Page?categoryId=7">
                <img src="~/img/index-imgs/kids Activities.jpg" alt="Kids Activities">
            </a>
            <div class="home_slider__content">
                <p class="home_slider__category">FAMILY</p>
                <h2 class="home_slider__title">Kids Activities</h2>
                <p class="home_slider__description">Kids activities are exciting and educational experiences that allow children to explore, learn, and have fun.</p>
            </div>
        </div>
    </div>

    <div class="home_slider__controls">
        <button id="prev" class="home_slider__button">
            &lt;
        </button>
        <button id="next" class="home_slider__button">
            &gt;
        </button>
    </div>

    <div class="home_thumbnail">
        <div class="home_thumbnail__item home_thumbnail__item--active">
            <a href="/Categories-Page?categoryId=2">
                <img src="~/img/index-imgs/stand up comedy.webp" alt="Stand-Up Comedy">
            </a>
            <div class="home_thumbnail__content">Stand-Up comedy</div>
        </div>
        <div class="home_thumbnail__item">
            <a href="/Categories-Page?categoryId=3">
                <img src="~/img/index-imgs/Conference.jpeg" alt="Conference">
            </a>
            <div class="home_thumbnail__content">Conference</div>
        </div>
        <div class="home_thumbnail__item">
            <a href="/Categories-Page?categoryId=4">
                <img src="~/img/index-imgs/Tech & Business Events.jpeg" alt="Tech & Business">
            </a>
            <div class="home_thumbnail__content">Tech & Business</div>
        </div>
        <div class="home_thumbnail__item">
            <a href="/Categories-Page?categoryId=5">
                <img src="~/img/index-imgs/Cultural & Art Events.jpeg" alt="Cultural & Art">
            </a>
            <div class="home_thumbnail__content">Cultural & Art</div>
        </div>
        <div class="home_thumbnail__item">
            <a href="/Categories-Page?categoryId=6">
                <img src="~/img/index-imgs/Festival.jpeg" alt="Festival">
            </a>
            <div class="home_thumbnail__content">Festival</div>
        </div>
        <div class="home_thumbnail__item">
            <a href="/Categories-Page?categoryId=7">
                <img src="~/img/index-imgs/kids Activities.jpg" alt="Kids Activities">
            </a>
            <div class="home_thumbnail__content">Kids Activities</div>
        </div>
    </div>
</div>
